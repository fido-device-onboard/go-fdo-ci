summary: Go FDO Client E2E Tests

tag:
  - client

discover:
    how: fmf
    filter: tag:e2e & tag:client
execute:
    how: tmt
prepare:
    - how: install
      package:
        - sqlite
        - openssl
        - curl
        - jq
        - iproute
        - procps-ng
provision:
    how: virtual
    memory: 4096
    disk: 30
